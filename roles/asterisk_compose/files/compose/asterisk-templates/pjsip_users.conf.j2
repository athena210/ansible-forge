[userauth-template](!)
type=auth
auth_type=digest
password={{ASTERISK_CLIENT_PASSWORD}}
;password_digest=

[userauth-aliens-template](!)
type=auth
auth_type=digest
password={{ASTERISK_ALIEN_PASSWORD}}
;password_digest=


[aor-template](!)
type=aor
max_contacts=20
minimum_expiration=30
default_expiration=300
maximum_expiration=600


[user-basic-template](!)
type=endpoint
direct_media=no
rtp_symmetric=yes
force_rport=yes
rtcp_mux=yes
rewrite_contact=yes
inband_progress=yes
subscribe_context=phone-hints
allow_subscribe=yes
disallow=all
;allow=opus,gsm,alaw,ulaw
allow=alaw,ulaw
context=dial-plan-main
message_context=messages


[user-template](!,user-basic-template)
transport=transport-udp


{% if PROJECT_CERT_PRESENT == 'YES' -%}
[user-tls-template](!,user-basic-template)
transport=transport-tls
{%- endif %}

#exec /etc/asterisk/users/users.sh pjsip
