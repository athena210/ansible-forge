[general]
enabled = yes              ; Включить AMI
webenabled = yes           ; Включить управление через web-интерфейс (если есть)
;bindaddr = 0.0.0.0
bindaddr = 127.0.0.1
port = 5038

[messenger]
secret = {{ASTERISK_SMS_PASSWORD}}
deny = 0.0.0.0/0.0.0.0
permit = 127.0.0.1
;read =                   ; Привилегии на чтение (наблюдение за событиями)
;write =                  ; Привилегии на запись (выполнение команд)

read =
write = message
